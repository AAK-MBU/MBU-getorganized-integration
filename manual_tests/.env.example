# manual_tests/.env.example — copy to manual_tests/.env and fill in:
#     cp manual_tests/.env.example manual_tests/.env
#
# The real .env is gitignored; this .example is tracked. live_go.py loads
# manual_tests/.env automatically. Real environment variables override the file
# for the same key (e.g. `export go_api_password=...` wins over the line here).
#
# Format: KEY=value, one per line. A line starting with '#' is a comment. The
# value is taken literally (no inline comments); surrounding single/double quotes
# are stripped. Values marked "JSON" must be valid JSON on a single line.
# Only fill in what the test(s) you want to run need; leave the rest blank.

# ---- credentials (also consumed by GoClient.from_env) -----------------------
go_api_endpoint=
go_api_username=
go_api_password=
# optional, only for convert_to_pdf:
LIBREOFFICE_PATH=

# ---- citizen / contact ------------------------------------------------------
# SSN required by: contact_lookup, find_cases_by_contact, find_citizen_folder,
#                  find_documents
SSN=
PERSON_FULL_NAME=
PERSON_ID=
CONTACT_SITE=borgersager

# ---- case search ------------------------------------------------------------
# BOR / EMN / PPR / AKT / ELM / PER / GEO / SAM / MOD
CASE_TYPE_PREFIX=BOR
CATEGORY=Borgermappe
RETURNED_CASES_NUMBER=1
# JSON. find_case: search by arbitrary GO field(s), no citizen tie-in. A value
# may be a plain string (Equal) or {"value": ..., "comparison": "Contains"}, e.g:
#   SEARCH_FIELD_PROPERTIES={"ows_Title": {"value": "Kørsel til", "comparison": "Contains"}}
SEARCH_FIELD_PROPERTIES={}

# ---- existing case id -------------------------------------------------------
# required by: open_case, close_case, get_case_metadata, upload_document
CASE_ID=
CASE_REASON=

# ---- create_case (WRITE) ----------------------------------------------------
# JSON dict of GoClient.create_case kwargs. Required: case_type_prefix, title,
# case_category, case_owner_id, case_owner_name, case_profile_id,
# case_profile_name. Optional: parent_case_id, department_id, department_name,
# kle_number, facet, special_group, start_date. Example:
#   CREATE_CASE={"case_type_prefix": "EMN", "title": "Manuel testsag", "case_category": "...", "case_owner_id": "...", "case_owner_name": "...", "case_profile_id": "...", "case_profile_name": "..."}
CREATE_CASE={}

# ---- documents --------------------------------------------------------------
# DOK_ID required by: document_metadata, download, convert_to_pdf, parents, children
DOK_ID=
VERSION_UI=
DOWNLOAD_PATH=
# JSON list[int]. required by: journalize_documents, finalize_documents
DOCUMENT_IDS=[]
# search_documents / modern_search
SEARCH_TERM=
SEARCH_START=
SEARCH_END=
# JSON. upload_document (WRITE). Provide a local file via "path" (bytes are read
# from it). "metadata" is a FIELD DICT (the <z:row> is built for you) — friendly
# keys date/title/receiver/category map to ows_Dato/ows_Title/ows_Modtagere/
# ows_Korrespondance, raw "ows_..." keys pass through, null = no metadata. Example:
#   UPLOAD={"filename": "test.txt", "path": "/tmp/test.txt", "metadata": {"title": "Brev", "date": "2026-08-20"}, "overwrite": false, "list_name": "Dokumenter", "folder_path": ""}
UPLOAD={"filename": "", "path": "", "metadata": null, "overwrite": false, "list_name": "Dokumenter", "folder_path": ""}

# ---- personalesag discovery -------------------------------------------------
TJENESTENUMMER=
